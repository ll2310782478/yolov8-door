.pytest_cache/
.coverage
htmlcov/
.tox/

# 构建和发布
build/
dist/
*.egg-info/
.eggs/

# Jupyter Notebook
.ipynb_checkpoints

# PyCharm
*.iml
.idea/

# macOS
.DS_Store
.AppleDouble
.LSOverride

