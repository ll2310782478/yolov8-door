# 数据库配置
# SQLite 版本：
# DATABASE_URL=sqlite:///./smartaccess.db

# MySQL 版本（推荐生产使用）：
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/smartaccess

# 应用配置
APP_NAME=SmartAccess
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production

# 认证配置
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 人脸识别配置
FACE_RECOGNITION_MODEL=face_recognition
CONFIDENCE_THRESHOLD=0.6
MAX_FACE_UPLOADS_PER_USER=5

# 访客配置
VISITOR_QR_EXPIRES_HOURS=24
VISITOR_MAX_DURATION_HOURS=8

# 邮件配置（用于发送访客二维码）
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=smartaccess@example.com
SMTP_FROM_NAME=SmartAccess系统

# 短信配置（可选，用于短信发送）
SMS_PROVIDER=aliyun
SMS_ACCESS_KEY=your-access-key
SMS_SECRET_KEY=your-secret-key
SMS_SIGN_NAME=SmartAccess

# NFC 设备配置
NFC_DEVICE_TIMEOUT=30
NFC_CARD_VALIDITY_DAYS=365

# 蓝牙设备配置
BLUETOOTH_SCAN_TIMEOUT=10
BLUETOOTH_LOCK_TIMEOUT=5

# 权限配置
FACE_PERMISSION_ENABLED=True
NFC_PERMISSION_ENABLED=True
BLUETOOTH_PERMISSION_ENABLED=True
